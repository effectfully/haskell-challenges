cabal-version:       2.2

name:                j2-guess-function
version:             0.1.0.0
-- synopsis:
-- description:
homepage:            https://github.com/githubuser/j2-guess-function#readme
author:              Author name here
maintainer:          example@example.com
copyright:           2026 Author name here
category:            Web
build-type:          Simple
extra-source-files:  README.md

library
  hs-source-dirs:      src
  exposed-modules:     Lib
                       Lib.ExprR
  default-language:    Haskell2010
  build-depends:       base >= 4.7 && < 5,
                       containers,
                       megaparsec,
                       prettyprinter,
                       primitive
  ghc-options:         -O2
                       -Wall
                       -Wcompat
                       -Widentities
                       -Wincomplete-record-updates
                       -Wincomplete-uni-patterns
                       -Wmissing-export-lists
                       -Wmissing-home-modules
                       -Wpartial-fields
                       -Wredundant-constraints

test-suite j2-guess-function-test
  type:                exitcode-stdio-1.0
  hs-source-dirs:      test
  main-is:             Main.hs
  other-modules:       ExprREq
                       NestingTests
                       PerformanceTests
                       PropertyTests
                       StressTests
  default-language:    Haskell2010
  build-depends:       base >= 4.7 && < 5,
                       containers,
                       j2-guess-function,
                       QuickCheck,
                       random,
                       random-shuffle,
                       tasty,
                       tasty-hunit,
                       tasty-quickcheck
  ghc-options:         -threaded
                       "-with-rtsopts=-N8 -M5G"
                       -rtsopts
                       -Wall
                       -Wcompat
                       -Widentities
                       -Wincomplete-record-updates
                       -Wincomplete-uni-patterns
                       -Wmissing-export-lists
                       -Wmissing-home-modules
                       -Wpartial-fields
                       -Wredundant-constraints

source-repository head
  type:     git
  location: https://github.com/githubuser/j2-guess-function
